#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: run <agent> [--print|--session-id|--no-sync] [-- extra args...]
       run --help
       run help

Agents:
  agy      Antigravity CLI
  claude   Claude Code
  codex    OpenAI Codex
  deepseek DeepSeek via omp
  glm      GLM via opencode
  grok     Grok Build (xAI)
  kimi     Kimi Code
  minimax  MiniMax Code
  muse     Muse Code
  qwen     Qwen via Qoder CLI

Worktrees:
  agy      ~/workspace/hctl2-agy
  claude   ~/workspace/hctl2-claude
  codex    ~/workspace/hctl2-codex
  deepseek ~/workspace/hctl2-deepseek
  glm      ~/workspace/hctl2-glm
  grok     ~/workspace/hctl2-grok
  kimi     ~/workspace/hctl2-kimi
  minimax  ~/workspace/hctl2-minimax
  muse     ~/workspace/hctl2-muse
  qwen     ~/workspace/hctl2-qwen

Options:
  --print, --dry-run  print cd + command without launching
  --session-id        print the selected persisted session id
  --no-sync           skip the pre-launch fast-forward to origin/main
  --                  pass remaining args to the target CLI

Session ids:
  macOS
    agy      30876bc1-f249-4569-b4cd-1a671577017d
    claude   197c3f1e-7e43-46b4-a228-26a497574897
    codex    01a027ea-f719-7a00-b833-2a587b2a05ac
    deepseek 01a0f80a-f89b-724e-aa8c-a77aef0339cb
    glm      ses_fd816ff58ffew9OZpjG0y62oc6
    grok     01a027e9-a557-7cf1-ac64-878cb7208851
    kimi     session_e96e0466-cdf7-4790-870f-20ae8b6e862b
    minimax  mvs_0086208ee21a435391daf10863c6f549
    muse     01a08ce4-5760-7673-abc1-edc3de391284
    qwen     34e94a5f-73b1-4e95-ba6d-b83f2e4f006e

  Ubuntu
    agy      c56d1e4d-9efc-4fea-a730-f40b5a9a5c65
    claude   0a0f76a9-0fff-4495-8682-ff7b61dca6b4
    codex    01a0e972-feb8-7562-9f37-5741175c456c
    deepseek 01a0e987-936a-73d6-a671-269e178fb7d5
    glm      ses_f167ca207ffeWkQBeksNkcSjFo
    grok     01a0e980-c22c-7cb2-85f1-ec27f2ba0716
    kimi     session_9cb83e83-3adf-4a4c-b354-bc8db0572579
    minimax  mvs_10a70eac3ad9485abc2471f39da69467
    muse     01a0e981-5fe8-71f3-898c-8bb01bd7ff10
    qwen     c32d605f-5c34-4748-ac64-1c7c4584cf73

Examples:
  ./run claude
  ./run codex --print
  ./run glm --session-id
  ./run codex -- --search
USAGE
}

die() {
  echo "run: $*" >&2
  exit 1
}

note() {
  echo "run: $*" >&2
}

# Fast-forward the harness branch to origin/main before the harness loads
# AGENTS.md / CONSTRAINTS.md. Never blocks the launch: offline, detached,
# dirty or diverged worktrees are reported and left untouched.
sync_worktree() {
  local branch counts behind ahead
  branch="$(git symbolic-ref --quiet --short HEAD)" || {
    note "detached HEAD; not syncing"
    return 0
  }
  if ! GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o ConnectTimeout=10" \
      git fetch --quiet --prune origin; then
    note "fetch failed; launching $branch at $(git rev-parse --short HEAD) unsynced"
    return 0
  fi
  counts="$(git rev-list --left-right --count origin/main...HEAD)" || {
    note "origin/main not found; not syncing"
    return 0
  }
  read -r behind ahead <<<"$counts"
  ((behind)) || return 0
  if ((ahead)); then
    note "$branch: $ahead local commit(s), $behind behind origin/main; review and rebase manually"
  elif ! git diff --quiet HEAD --; then
    note "$branch: $behind behind origin/main, but tracked files are modified; not syncing"
  elif git merge --ff-only --quiet origin/main; then
    note "$branch: fast-forwarded $behind commit(s) to origin/main"
  else
    note "$branch: fast-forward to origin/main failed; launching unsynced"
  fi
}

quote_cmd() {
  local part
  printf '%q' "$1"
  shift
  for part in "$@"; do
    printf ' %q' "$part"
  done
  printf '\n'
}

agent=""
print_only=0
sync=1
session_only=0
extra=()

while (($#)); do
  case "$1" in
    --print|--dry-run) print_only=1 ;;
    --session-id) session_only=1 ;;
    --no-sync) sync=0 ;;
    -h|--help|help) usage; exit 0 ;;
    --)
      shift
      extra=("$@")
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [[ -n "$agent" ]]; then
        die "unexpected argument: $1"
      fi
      agent="$1"
      ;;
  esac
  shift
done

[[ -n "$agent" ]] || { usage; exit 2; }

case "$(uname -s)" in
  Darwin) platform="macos" ;;
  Linux)  platform="ubuntu" ;;
  *)      die "unsupported platform: $(uname -s)" ;;
esac

workspace="$HOME/workspace"

case "$agent" in
  agy)
    workdir="$workspace/hctl2-agy"
    case "$platform" in
      macos)  session="30876bc1-f249-4569-b4cd-1a671577017d" ;;
      ubuntu) session="c56d1e4d-9efc-4fea-a730-f40b5a9a5c65" ;;
    esac
    cmd=(agy --dangerously-skip-permissions --conversation "$session")
    ;;
  claude)
    workdir="$workspace/hctl2-claude"
    case "$platform" in
      macos)  session="dccc85c7-d24a-45e1-86a2-447b46b1da60" ;;
      ubuntu) session="0a0f76a9-0fff-4495-8682-ff7b61dca6b4" ;;
    esac
    cmd=(claude --dangerously-skip-permissions --resume "$session")
    ;;
  codex)
    workdir="$workspace/hctl2-codex"
    case "$platform" in
      macos)  session="01a027ea-f719-7a00-b833-2a587b2a05ac" ;;
      ubuntu) session="01a0e972-feb8-7562-9f37-5741175c456c" ;;
    esac
    cmd=(codex --dangerously-bypass-approvals-and-sandbox -C "$workdir" resume "$session")
    ;;
  deepseek)
    workdir="$workspace/hctl2-deepseek"
    case "$platform" in
      macos)  session="01a0f80a-f89b-724e-aa8c-a77aef0339cb" ;;
      ubuntu) session="01a0e987-936a-73d6-a671-269e178fb7d5" ;;
    esac
    cmd=(omp --auto-approve --resume "$session")
    ;;
  glm)
    workdir="$workspace/hctl2-glm"
    case "$platform" in
      macos)  session="ses_fd816ff58ffew9OZpjG0y62oc6" ;;
      ubuntu) session="ses_f167ca207ffeWkQBeksNkcSjFo" ;;
    esac
    cmd=(opencode -s "$session" "$workdir")
    ;;
  grok)
    workdir="$workspace/hctl2-grok"
    case "$platform" in
      macos)  session="01a027e9-a557-7cf1-ac64-878cb7208851" ;;
      ubuntu) session="01a0e980-c22c-7cb2-85f1-ec27f2ba0716" ;;
    esac
    cmd=(grok --always-approve --resume "$session")
    ;;
  kimi)
    workdir="$workspace/hctl2-kimi"
    case "$platform" in
      macos)  session="session_e96e0466-cdf7-4790-870f-20ae8b6e862b" ;;
      ubuntu) session="session_9cb83e83-3adf-4a4c-b354-bc8db0572579" ;;
    esac
    cmd=(kimi --auto -S "$session")
    ;;
  minimax)
    workdir="$workspace/hctl2-minimax"
    case "$platform" in
      macos)  session="mvs_0086208ee21a435391daf10863c6f549" ;;
      ubuntu) session="mvs_10a70eac3ad9485abc2471f39da69467" ;;
    esac
    cmd=(mcode --session "$session")
    ;;
  muse)
    workdir="$workspace/hctl2-muse"
    case "$platform" in
      macos)  session="01a08ce4-5760-7673-abc1-edc3de391284" ;;
      ubuntu) session="01a0e981-5fe8-71f3-898c-8bb01bd7ff10" ;;
    esac
    cmd=(muse --yolo resume "$session")
    ;;
  qwen)
    workdir="$workspace/hctl2-qwen"
    case "$platform" in
      macos)  session="34e94a5f-73b1-4e95-ba6d-b83f2e4f006e" ;;
      ubuntu) session="c32d605f-5c34-4748-ac64-1c7c4584cf73" ;;
    esac
    cmd=(qoderclicn --dangerously-skip-permissions --resume "$session")
    ;;
  *)
    die "unknown agent: $agent"
    ;;
esac

if ((session_only)); then
  printf '%s\n' "$session"
  exit 0
fi

if ((${#extra[@]})); then
  cmd+=("${extra[@]}")
fi

# Session-scoped attribution handle inherited by harness tool subprocesses.
export COAGNET_HARNESS="$agent"
export COAGNET_SESSION_ID="$session"

if ((print_only)); then
  printf 'cd '
  quote_cmd "$workdir"
  printf 'export COAGNET_HARNESS='
  quote_cmd "$COAGNET_HARNESS"
  printf 'export COAGNET_SESSION_ID='
  quote_cmd "$COAGNET_SESSION_ID"
  printf 'exec '
  quote_cmd "${cmd[@]}"
  exit 0
fi

[[ -d "$workdir" ]] || die "worktree not found: $workdir"
command -v "${cmd[0]}" >/dev/null 2>&1 || die "command not found: ${cmd[0]}"
cd "$workdir"
if ((sync)); then
  sync_worktree
fi

if [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ [Uu][Tt][Ff]-?8 ]]; then
  case "$agent" in
    agy)    term_title="HCTL2 · 🛠 𝕬𝖓𝖙𝖎𝖌𝖗𝖆𝖛𝖎𝖙𝖞" ;;
    claude) term_title="HCTL2 · ✴️ 𝑪𝒍𝒂𝒖𝒅𝒆" ;;
    codex)  term_title="HCTL2 · ❄️ 𝗖𝗼𝗱𝗲𝘅" ;;
    deepseek) term_title="HCTL2 · 🐋 𝘿𝙚𝙚𝙥𝙎𝙚𝙚𝙠" ;;
    glm)    term_title="HCTL2 · 🔳 🅶🅻🅼" ;;
    grok)   term_title="HCTL2 · 🛰️ 𝐆𝐫𝐨𝐤" ;;
    kimi)   term_title="HCTL2 · 🎹 𝕂𝕚𝕞𝕚" ;;
    minimax) term_title="HCTL2 · 〽️ 𝘔𝘪𝘯𝘪𝘔𝘢𝘹" ;;
    muse)   term_title="HCTL2 · 🥨 𝓜𝓾𝓼𝓮" ;;
    qwen)   term_title="HCTL2 · 🌀 𝚀𝚠𝚎𝚗" ;;
    *)      term_title="HCTL2 · $agent" ;;
  esac
else
  case "$agent" in
    agy)    term_title="HCTL2 · Antigravity" ;;
    claude) term_title="HCTL2 · Claude" ;;
    codex)  term_title="HCTL2 · Codex" ;;
    deepseek) term_title="HCTL2 · DeepSeek" ;;
    glm)    term_title="HCTL2 · GLM" ;;
    grok)   term_title="HCTL2 · Grok" ;;
    kimi)   term_title="HCTL2 · Kimi" ;;
    minimax) term_title="HCTL2 · MiniMax" ;;
    muse)   term_title="HCTL2 · Muse" ;;
    qwen)   term_title="HCTL2 · Qwen" ;;
    *)      term_title="HCTL2 · $agent" ;;
  esac
fi

printf '\033]0;%s\007' "$term_title"
(
  # Some CLIs overwrite the title during startup; refresh it a few times.
  sleep 0.5; printf '\033]0;%s\007' "$term_title"
  sleep 1.0; printf '\033]0;%s\007' "$term_title"
  sleep 1.5; printf '\033]0;%s\007' "$term_title"
) &

exec "${cmd[@]}"
