src/third-party/rust/BUCK whitespace=-blank-at-eof

# Documentation review profiles. Later rules override earlier ones.
/README.md hctl-doc=design
/AGENTS.md hctl-doc=design
/CONSTRAINTS.md hctl-doc=design
/WRITING-GUIDE.md hctl-doc=design
/docs/design/** hctl-doc=design
/docs/design/spec/** hctl-doc=spec
/docs/design/contract-tests.md hctl-doc=spec
/docs/design/delivery.md hctl-doc=delivery
/docs/usage.md hctl-doc=delivery
/docs/research/** hctl-doc=research
# Source-side Markdown uses only the retired-name check, not design prose rules.
/src/**/*.md hctl-doc=src
/src/third-party/** !hctl-doc
/src/buck-out/** !hctl-doc
/src/target/** !hctl-doc
/.memo/** hctl-doc=memo
/.memo/review/** hctl-doc=memo-review
