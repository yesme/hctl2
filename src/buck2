#!/bin/sh
set -eu

# This launcher lives in src/ (the `root` cell); the Buck2 project root is the
# repository root, which the binary finds via .buckroot. $project_root here only
# locates the pinned tools next to the launcher.
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
buck2_bin=$project_root/build/tools/buck2-bin
process_compose=$project_root/build/tools/process-compose-bin
cache_config=$project_root/build/reapi/local-cache.yaml

# The Buck2 prelude's Cargo build-script C/C++ shim requires Python >= 3.12,
# but actions run in a hermetic environment without PATH: the bare `python3`
# from the default python_bootstrap toolchain resolves to /usr/bin/python3
# (3.9.6 on macOS). Resolve the pinned interpreter and inject it as config;
# build/toolchains/BUCK wires it into the toolchain. A broken pin must fail
# here rather than silently falling back to the host interpreter.
py_bin=$("$project_root/build/tools/host-bin/python3" -c 'import sys; print(sys.prefix + "/bin/python3")') || {
    printf 'error: pinned host Python at build/tools/host-bin/python3 is unusable\n' >&2
    exit 1
}
case "$py_bin" in
    /*) ;;
    *)
        printf 'error: pinned host Python path is not absolute: %s\n' "$py_bin" >&2
        exit 1
        ;;
esac

# The prelude's build-script C/C++ shim re-execs the compiler via os.execl,
# which does not search PATH; bare compiler names from the default system
# toolchain fail with ENOENT. Resolve absolute paths here and feed them to the
# cxx toolchain through config (see build/toolchains/BUCK). Prefer the
# /usr/bin xcrun shims on macOS: they inject the active SDK, which the raw
# toolchain binaries inside Xcode.app do not do without -isysroot.
if [ "$(uname -s)" = Darwin ]; then
    if [ -x /usr/bin/clang ]; then
        cc_bin=/usr/bin/clang
        cxx_bin=/usr/bin/clang++
        ar_bin=/usr/bin/ar
    else
        cc_bin=$(xcrun --find clang)
        cxx_bin=$(xcrun --find clang++)
        ar_bin=$(xcrun --find ar)
    fi
else
    cc_bin=$(command -v clang || command -v cc || true)
    cxx_bin=$(command -v clang++ || command -v c++ || true)
    ar_bin=$(command -v ar || true)
fi

case "${1:-}" in
    aquery | build | cquery | query | run | targets | test | uquery)
        buck_command=$1
        shift
        set -- "--config" "hctl2.python=$py_bin" "$@"
        if [ -n "$ar_bin" ]; then
            set -- "--config" "hctl2.ar=$ar_bin" "$@"
        fi
        if [ -n "$cxx_bin" ]; then
            set -- "--config" "hctl2.cxx=$cxx_bin" "$@"
        fi
        if [ -n "$cc_bin" ]; then
            set -- "--config" "hctl2.cc=$cc_bin" "$@"
        fi
        set -- "$buck_command" "$@"
        ;;
esac

if [ "$(uname -s)" = Darwin ]; then
    xcode_version=$(xcodebuild -version | awk 'NR == 1 { print $2 }')
    xcode_build=$(xcodebuild -version | awk 'NR == 2 { print $3 }')
    macos_sdk_version=$(xcrun --sdk macosx --show-sdk-version)
    test -n "$xcode_version" && test -n "$xcode_build" && test -n "$macos_sdk_version"
    case "${1:-}" in
        aquery | build | cquery | query | run | targets | test | uquery)
            buck_command=$1
            shift
            set -- \
                "$buck_command" \
                --config "hctl2.macos_xcode_version=$xcode_version" \
                --config "hctl2.macos_xcode_build=$xcode_build" \
                --config "hctl2.macos_sdk_version=$macos_sdk_version" \
                "$@"
            ;;
    esac
fi

case "${HCTL2_BUCK2_CACHE:-local}" in
    0 | false | no)
        BUCK_OFFLINE_BUILD=true exec "$buck2_bin" "$@"
        ;;
    remote)
        if [ ! -f "$project_root/../.buckconfig.local" ]; then
            printf '%s\n' \
                'error: HCTL2_BUCK2_CACHE=remote requires .buckconfig.local at the repository root' >&2
            exit 1
        fi
        exec "$buck2_bin" "$@"
        ;;
    1 | true | yes | local)
        ;;
    *)
        printf 'error: unsupported HCTL2_BUCK2_CACHE mode: %s\n' \
            "$HCTL2_BUCK2_CACHE" >&2
        exit 2
        ;;
esac

cache_root=${HCTL2_BUCK2_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hctl2/buck2-reapi}
cache_data_dir=$cache_root/data
cache_state_dir=$cache_root/state
cache_socket=$cache_state_dir/process-compose.sock
process_compose_log=$cache_state_dir/process-compose.log
bazel_remote_log=$cache_state_dir/bazel-remote.log
process_compose_config_home=$cache_state_dir/config
mkdir -p "$cache_data_dir" "$process_compose_config_home/process-compose"

if ! XDG_CONFIG_HOME=$process_compose_config_home \
    "$process_compose" --use-uds --unix-socket "$cache_socket" \
    process list >/dev/null 2>&1 && \
    ! curl --fail --silent --max-time 1 http://127.0.0.1:19090/status \
        >/dev/null 2>&1; then
    HCTL2_BAZEL_REMOTE_BIN=$project_root/build/tools/bazel-remote-bin \
    HCTL2_BUCK2_CACHE_DATA_DIR=$cache_data_dir \
    HCTL2_BUCK2_CACHE_HTTP_ADDRESS=127.0.0.1:19090 \
    HCTL2_BUCK2_CACHE_HTTP_PORT=19090 \
    HCTL2_BUCK2_CACHE_GRPC_ADDRESS=127.0.0.1:19092 \
    HCTL2_BUCK2_CACHE_LOG=$bazel_remote_log \
    HCTL2_BUCK2_CACHE_MAX_GIB=${HCTL2_BUCK2_CACHE_MAX_GIB:-10} \
    XDG_CONFIG_HOME=$process_compose_config_home \
        "$process_compose" \
        --use-uds \
        --unix-socket "$cache_socket" \
        --log-file "$process_compose_log" \
        up \
        --config "$cache_config" \
        --disable-dotenv \
        --detached ||
        XDG_CONFIG_HOME=$process_compose_config_home \
            "$process_compose" --use-uds --unix-socket "$cache_socket" \
            process list >/dev/null
fi

exec "$buck2_bin" "$@"
