load(":defs.bzl", "complete_release", "first_party_release")
load("//build/rules:ci.bzl", "CI_RELEASE")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

# Export this package's Markdown; the root glob stops at BUCK boundaries.
filegroup(
    name = "docs",
    srcs = glob(["**/*.md"]),
    visibility = ["PUBLIC"],
)

export_file(
    name = "export-first-party.sh",
    src = "export-first-party.sh",
)

export_file(
    name = "test-toolbox.sh",
    src = "test-toolbox.sh",
)

export_file(
    name = "demo3.sh",
    src = "demo3.sh",
)

first_party_release(name = "first-party")

complete_release(name = "complete")

# This test consumes the real offline payload; keep compression/source archives out of Code CI.
rust_test(
    name = "room-cli-test",
    mapped_srcs = {"root//apps/cli:room_cli_source": "room.rs", "root//apps/cli:project_cli_source": "room/project.rs", "root//apps/cli:agency_cli_source": "room/agency.rs"},
    crate_root = "room.rs",
    deps = [
        "root//apps/control:control",
        "root//crates/agency-proto:agency_proto",
        "root//crates/chat:chat",
        "root//crates/foundation:foundation",
        "root//crates/store:store",
        "root//third-party/rust:serde_json",
    ],
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env() | {
        "CARGO_BIN_EXE_hctl2": "$(location root//apps/cli:hctl2)",
        "CARGO_BIN_EXE_hctl2-control": "$(location root//apps/control:hctl2-control)",
        "CARGO_BIN_EXE_agency": "$(location root//agency:agency)",
        "HCTL2_STANDBY_FIXTURE": "$(location root//agency:standby_fixture)",
        "HCTL2_TEST_DEPENDENCY_PACKAGE": "$(location root//packaging/dependencies:package)",
        "HCTL2_ZSTD_ROOT": "$(location root//build/tools:zstd-bin)",
    },
    labels = CI_RELEASE,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "room-cli-clippy",
    srcs = {"room": ":room-cli-test[clippy.txt]"},
    labels = CI_RELEASE,
    visibility = ["PUBLIC"],
)

# The clippy run writes room-cli-test's diagnostics to a report and succeeds
# either way, and this package is only built by the release workflow, so
# nothing downstream of :room-cli-clippy would ever fail on a non-empty report.
# It needs the same gate the first-party targets get in
# root//build/tests:clippy_clean_test. The report stays out of the root
# filegroup on purpose: this package carries the complete offline payload, which
# Code CI must not build, and CI_RELEASE keeps Buck2 Change Detector from
# selecting this test for the Code matrix.
sh_test(
    name = "room-cli-clippy-clean-test",
    test = "//build/tests:check-clippy-clean.sh",
    env = {"CLIPPY_REPORTS": "$(location :room-cli-clippy)"},
    labels = CI_RELEASE,
    test_rule_timeout_ms = 120000,
    visibility = ["PUBLIC"],
)

# Demo 3, both paths (kickoff §四 第 9 包验收第 8 条). Like room-cli-test these
# consume the real offline payload and drive only `hctl2 --json`, so the
# packaged Gitea, Tuwunel, process-compose and gh are the ones under test.
# HCTL2_DEMO3_GITHUB_TOKEN is not declared here: the workflow passes it through
# `buck2 test -- --env`, which keeps the runner secret out of the action key and
# out of the graph. Without it demo3-github.sh skips visibly instead of failing.
_DEMO3_ENV = {
    "HCTL2_AGENCY_BIN": "$(location root//agency:agency)",
    "HCTL2_CLI_BIN": "$(location root//apps/cli:hctl2)",
    "HCTL2_CONTROL_BIN": "$(location root//apps/control:hctl2-control)",
    "HCTL2_DEMO3_COMMON": "$(location :demo3.sh)",
    "HCTL2_JQ": "$(location root//build/tools:jq-bin)",
    "HCTL2_TEST_DEPENDENCY_PACKAGE": "$(location root//packaging/dependencies:package)",
    "HCTL2_ZSTD_ROOT": "$(location root//build/tools:zstd-bin)",
}

_DEMO3_RESOURCES = [
    ":demo3.sh",
    "root//agency:agency",
    "root//apps/cli:hctl2",
    "root//apps/control:hctl2-control",
    "root//build/tools:jq-bin",
    "root//build/tools:zstd-bin",
    "root//packaging/dependencies:package",
]

# The streaming unpack both paths share, pinned on fixtures of a few hundred
# bytes: a valid archive carrying trailing padding must unpack, and an archive
# whose zstd frame fails its own content checksum must be refused. Sourcing
# demo3.sh runs its "Buck must provide" guards, so the binaries those name are
# declared even though this test never runs one of them. The dependency package
# is the deliberate exception: declaring it would pull the whole offline payload
# into a test that reads none of it, and into the disk budget of the job that
# runs it. The guard only asks that the variable be non-empty.
_DEMO3_UNPACK_ENV = _DEMO3_ENV | {
    "HCTL2_TEST_DEPENDENCY_PACKAGE": "unused-by-demo3-unpack-test",
}

sh_test(
    name = "demo3-unpack-test",
    test = "demo3-unpack-test.sh",
    env = _DEMO3_UNPACK_ENV,
    resources = [r for r in _DEMO3_RESOURCES if r != "root//packaging/dependencies:package"],
    labels = CI_RELEASE,
    test_rule_timeout_ms = 120000,
    visibility = ["PUBLIC"],
)

sh_test(
    name = "demo3-gitea-test",
    test = "demo3-gitea.sh",
    env = _DEMO3_ENV,
    resources = _DEMO3_RESOURCES,
    labels = CI_RELEASE,
    run_test_separately = True,
    test_rule_timeout_ms = 600000,
    visibility = ["PUBLIC"],
)

sh_test(
    name = "demo3-github-test",
    test = "demo3-github.sh",
    env = _DEMO3_ENV,
    resources = _DEMO3_RESOURCES,
    labels = CI_RELEASE,
    run_test_separately = True,
    test_rule_timeout_ms = 600000,
    visibility = ["PUBLIC"],
)
