load(":defs.bzl", "complete_release", "first_party_release")
load("//build/rules:ci.bzl", "CI_RELEASE")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

export_file(
    name = "export-first-party.sh",
    src = "export-first-party.sh",
)

export_file(
    name = "test-toolbox.sh",
    src = "test-toolbox.sh",
)

first_party_release(name = "first-party")

complete_release(name = "complete")

# This test consumes the real offline payload; keep compression/source archives out of Code CI.
rust_test(
    name = "room-cli-test",
    mapped_srcs = {"root//apps/cli:room_cli_source": "room.rs"},
    crate_root = "room.rs",
    deps = [
        "root//crates/chat:chat",
        "root//crates/foundation:foundation",
        "root//crates/store:store",
        "root//third-party/rust:serde_json",
    ],
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env() | {
        "CARGO_BIN_EXE_hctl2": "$(location root//apps/cli:hctl2)",
        "CARGO_BIN_EXE_hctl2-control": "$(location root//apps/control:hctl2-control)",
        "HCTL2_TEST_DEPENDENCY_PACKAGE": "$(location root//packaging/dependencies:package)",
    },
    labels = CI_RELEASE,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "room-cli-clippy",
    srcs = {"room": ":room-cli-test[clippy.txt]"},
    labels = CI_RELEASE,
    visibility = ["PUBLIC"],
)
