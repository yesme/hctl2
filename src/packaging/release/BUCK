load(":defs.bzl", "complete_release", "first_party_release")
load("//build/rules:ci.bzl", "CI_RELEASE")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

export_file(
    name = "export-first-party.sh",
    src = "export-first-party.sh",
)

export_file(
    name = "test-toolbox.sh",
    src = "test-toolbox.sh",
)

first_party_release(name = "first-party")

complete_release(name = "complete")

# This test consumes the real offline payload; keep compression/source archives out of Code CI.
rust_test(
    name = "room-cli-test",
    mapped_srcs = {"root//apps/cli:room_cli_source": "room.rs", "root//apps/cli:project_cli_source": "room/project.rs"},
    crate_root = "room.rs",
    deps = [
        "root//crates/chat:chat",
        "root//crates/foundation:foundation",
        "root//crates/store:store",
        "root//third-party/rust:serde_json",
    ],
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env() | {
        "CARGO_BIN_EXE_hctl2": "$(location root//apps/cli:hctl2)",
        "CARGO_BIN_EXE_hctl2-control": "$(location root//apps/control:hctl2-control)",
        "HCTL2_TEST_DEPENDENCY_PACKAGE": "$(location root//packaging/dependencies:package)",
        "HCTL2_ZSTD_ROOT": "$(location root//build/tools:zstd-bin)",
    },
    labels = CI_RELEASE,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "room-cli-clippy",
    srcs = {"room": ":room-cli-test[clippy.txt]"},
    labels = CI_RELEASE,
    visibility = ["PUBLIC"],
)

# The clippy run writes room-cli-test's diagnostics to a report and succeeds
# either way, and this package is only built by the release workflow, so
# nothing downstream of :room-cli-clippy would ever fail on a non-empty report.
# It needs the same gate the first-party targets get in
# root//build/tests:clippy_clean_test. The report stays out of the root
# filegroup on purpose: this package carries the complete offline payload, which
# Code CI must not build, and CI_RELEASE keeps Buck2 Change Detector from
# selecting this test for the Code matrix.
sh_test(
    name = "room-cli-clippy-clean-test",
    test = "//build/tests:check-clippy-clean.sh",
    env = {"CLIPPY_REPORTS": "$(location :room-cli-clippy)"},
    labels = CI_RELEASE,
    test_rule_timeout_ms = 120000,
    visibility = ["PUBLIC"],
)
