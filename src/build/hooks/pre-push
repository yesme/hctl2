#!/bin/sh
set -eu

remote_name=$1
repo_root=$(git rev-parse --show-toplevel)
zero_oid=0000000000000000000000000000000000000000
verified_oids=

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_ref:$local_oid" in
        refs/heads/*:$zero_oid) continue ;;
        refs/heads/*:*) ;;
        *) continue ;;
    esac

    case " $verified_oids " in
        *" $local_oid "*) continue ;;
    esac

    if [ "$remote_oid" != "$zero_oid" ] \
        && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        base=$(git merge-base "$remote_oid" "$local_oid")
    elif git show-ref --verify --quiet "refs/remotes/$remote_name/main"; then
        base=$(git merge-base "refs/remotes/$remote_name/main" "$local_oid")
    elif git rev-parse --verify "$local_oid^" >/dev/null 2>&1; then
        base=$(git rev-parse --verify "$local_oid^")
    else
        printf 'No parent commit is available for %s; CI will perform the first full check.\n' \
            "$local_ref"
        continue
    fi

    printf 'Running HCTL2 affected gate for %s (%s..%s).\n' \
        "$local_ref" "$base" "$local_oid"
    "$repo_root/src/build/ci/verify-affected" \
        --base "$base" \
        --head "$local_oid"
    verified_oids="$verified_oids $local_oid"
done
