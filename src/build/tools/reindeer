#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)

# shellcheck source=reindeer.env
. "$script_dir/reindeer.env"

cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/hctl2/tools/reindeer
install_root=$cache_root/$REINDEER_VERSION-$REINDEER_COMMIT
reindeer_bin=$install_root/bin/reindeer

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

if [ ! -x "$reindeer_bin" ]; then
    command -v curl >/dev/null 2>&1 || {
        printf '%s\n' 'error: curl is required to bootstrap Reindeer' >&2
        exit 1
    }
    command -v cargo >/dev/null 2>&1 || {
        printf '%s\n' 'error: Cargo with Rust 1.98.0 is required to bootstrap Reindeer' >&2
        exit 1
    }

    work_dir=$(mktemp -d "${TMPDIR:-/tmp}/hctl2-reindeer.XXXXXX")
    cleanup() {
        rm -rf -- "$work_dir"
    }
    trap cleanup 0 1 2 15

    source_archive=$work_dir/reindeer.tar.gz
    source_dir=$work_dir/source
    temporary_install=$work_dir/install
    mkdir -p "$source_dir" "$cache_root"

    curl --fail --location --proto '=https' --tlsv1.2 \
        "$REINDEER_SOURCE_URL" \
        --output "$source_archive"

    actual_sha256=$(sha256_file "$source_archive")
    if [ "$actual_sha256" != "$REINDEER_SOURCE_SHA256" ]; then
        printf 'error: Reindeer source SHA-256 mismatch: expected %s, got %s\n' \
            "$REINDEER_SOURCE_SHA256" "$actual_sha256" >&2
        exit 1
    fi

    tar -xzf "$source_archive" -C "$source_dir" --strip-components=1
    RUSTUP_TOOLCHAIN=1.98.0 cargo install \
        --locked \
        --path "$source_dir" \
        --root "$temporary_install"

    if [ ! -e "$install_root" ]; then
        mv "$temporary_install" "$install_root"
    fi
fi

cd "$project_root"
exec "$reindeer_bin" "$@"
