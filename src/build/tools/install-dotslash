#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Install the pinned DotSlash release for the current HCTL2 build host.

Usage:
  install-dotslash <install-directory>
  install-dotslash --help
EOF
}

case "${1:-}" in
    --help | -h)
        usage
        exit 0
        ;;
    "")
        usage >&2
        exit 2
        ;;
esac
if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=dotslash.env
. "$script_dir/dotslash.env"

case "$(uname -s):$(uname -m)" in
    Linux:x86_64)
        asset=$DOTSLASH_LINUX_X86_64_ASSET
        expected_sha256=$DOTSLASH_LINUX_X86_64_SHA256
        ;;
    Darwin:x86_64)
        asset=$DOTSLASH_MACOS_X86_64_ASSET
        expected_sha256=$DOTSLASH_MACOS_X86_64_SHA256
        ;;
    Darwin:arm64)
        asset=$DOTSLASH_MACOS_ARM64_ASSET
        expected_sha256=$DOTSLASH_MACOS_ARM64_SHA256
        ;;
    *)
        printf 'error: unsupported DotSlash build host: %s %s\n' "$(uname -s)" "$(uname -m)" >&2
        exit 1
        ;;
esac

install_dir=$1
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/hctl2-dotslash.XXXXXX")
cleanup() {
    rm -rf -- "$work_dir"
}
trap cleanup 0 1 2 15

archive=$work_dir/dotslash.tar.gz
url=https://github.com/facebook/dotslash/releases/download/$DOTSLASH_VERSION/$asset
mkdir -p "$install_dir"
curl --fail --location --proto '=https' --tlsv1.2 "$url" --output "$archive"

if command -v sha256sum >/dev/null 2>&1; then
    actual_sha256=$(sha256sum "$archive" | awk '{print $1}')
else
    actual_sha256=$(shasum -a 256 "$archive" | awk '{print $1}')
fi
if [ "$actual_sha256" != "$expected_sha256" ]; then
    printf 'error: DotSlash SHA-256 mismatch: expected %s, got %s\n' \
        "$expected_sha256" "$actual_sha256" >&2
    exit 1
fi

tar -xzf "$archive" -C "$install_dir"
"$install_dir/dotslash" --version
