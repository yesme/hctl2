#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Control the HCTL2 local Buck2 REAPI action cache.

Usage:
  buck2-cache start
  buck2-cache stop
  buck2-cache status
  buck2-cache benchmark [-- <buck2-test-arguments>]
EOF
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cache_root=${HCTL2_BUCK2_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hctl2/buck2-reapi}
data_dir=$cache_root/data
state_dir=$cache_root/state
pid_file=$state_dir/server.pid
log_file=$state_dir/server.log
lock_dir=$state_dir/start.lock
max_size=${HCTL2_BUCK2_CACHE_MAX_GIB:-10}
server=$script_dir/bazel-remote-bin
project_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)

running_pid() {
    if [ ! -f "$pid_file" ]; then
        return 1
    fi
    pid=$(sed -n '1p' "$pid_file")
    case "$pid" in
        '' | *[!0-9]*) return 1 ;;
    esac
    if ! kill -0 "$pid" 2>/dev/null; then
        return 1
    fi
    command=$(ps -p "$pid" -o command= 2>/dev/null || true)
    case "$command" in
        *bazel-remote*"$data_dir"*) return 0 ;;
        *) return 1 ;;
    esac
}

cache_ready() {
    running_pid \
        && curl --fail --silent --max-time 1 http://127.0.0.1:19090/status \
            >/dev/null 2>&1
}

wait_until_ready() {
    attempts=0
    while [ "$attempts" -lt 600 ]; do
        if cache_ready; then
            return 0
        fi
        if ! running_pid; then
            return 1
        fi
        attempts=$((attempts + 1))
        sleep 0.1
    done
    return 1
}

start_cache() {
    mkdir -p "$data_dir" "$state_dir"
    if cache_ready; then
        return 0
    fi
    if running_pid; then
        if wait_until_ready; then
            return 0
        fi
        printf '%s\n' 'error: Buck2 action cache process exited before becoming ready' >&2
        tail -20 "$log_file" >&2 || true
        return 1
    fi

    attempts=0
    until mkdir "$lock_dir" 2>/dev/null; do
        if running_pid; then
            if wait_until_ready; then
                return 0
            fi
            printf '%s\n' 'error: Buck2 action cache process exited before becoming ready' >&2
            tail -20 "$log_file" >&2 || true
            return 1
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 600 ]; then
            printf '%s\n' 'error: timed out waiting for the Buck2 action cache start lock' >&2
            return 1
        fi
        sleep 0.1
    done
    trap 'rmdir "$lock_dir" 2>/dev/null || true' 0 1 2 15

    if ! running_pid; then
        nohup "$server" \
            --dir "$data_dir" \
            --max_size "$max_size" \
            --http_address 127.0.0.1:19090 \
            --grpc_address 127.0.0.1:19092 \
            </dev/null >>"$log_file" 2>&1 &
        pid=$!
        printf '%s\n' "$pid" >"$pid_file"
    fi

    wait_until_ready && return 0
    printf '%s\n' 'error: Buck2 action cache failed to start' >&2
    tail -20 "$log_file" >&2 || true
    return 1
}

stop_cache() {
    if ! running_pid; then
        rm -f "$pid_file"
        return 0
    fi
    kill "$pid"
    attempts=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 100 ]; do
        attempts=$((attempts + 1))
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        printf 'error: Buck2 action cache process %s did not stop\n' "$pid" >&2
        return 1
    fi
    rm -f "$pid_file"
}

benchmark_cache() {
    if [ "${1:-}" = -- ]; then
        shift
    fi
    if [ "$#" -eq 0 ]; then
        set -- \
            test \
            --build-default-info \
            root//apps/... \
            root//crates/... \
            root//build/tests/... \
            root//:clippy \
            root//packaging/release:first-party
    fi
    case "${HCTL2_BUCK2_CACHE:-local}" in
        0 | false | no)
            printf '%s\n' 'error: cache benchmark requires a local or remote cache' >&2
            return 2
            ;;
    esac

    work_dir=$(mktemp -d "${TMPDIR:-/tmp}/hctl2-cache-benchmark.XXXXXX")
    isolation=hctl2-cache-benchmark
    buck2_bin=$project_root/build/tools/buck2-bin
    buck2_launcher=$project_root/buck2
    cleanup_benchmark() {
        BUCK_ISOLATION_DIR=$isolation "$buck2_bin" clean >/dev/null 2>&1 || true
        rm -rf -- "$work_dir"
    }
    trap cleanup_benchmark 0 1 2 15

    run_clean() {
        BUCK_ISOLATION_DIR=$isolation "$buck2_bin" clean >/dev/null
    }
    run_phase() {
        phase=$1
        shift
        event_log=$work_dir/$phase.pb.zst
        "$@" --event-log "$event_log"
    }
    show_phase() {
        phase=$1
        event_log=$work_dir/$phase.pb.zst
        printf '\n=== %s ===\n' "$phase"
        "$buck2_bin" log summary "$event_log"
        "$buck2_bin" log what-uploaded "$event_log"
    }

    cd "$project_root"
    run_clean
    run_phase cold-no-cache \
        env BUCK_ISOLATION_DIR=$isolation "$buck2_bin" "$@" --no-remote-cache
    run_clean
    run_phase cache-seed \
        env BUCK_ISOLATION_DIR=$isolation "$buck2_launcher" "$@"
    run_clean
    run_phase cache-reuse \
        env BUCK_ISOLATION_DIR=$isolation "$buck2_launcher" "$@"

    show_phase cold-no-cache
    show_phase cache-seed
    show_phase cache-reuse
}

case "${1:-}" in
    start)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        start_cache
        ;;
    stop)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        stop_cache
        ;;
    status)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        if cache_ready; then
            printf 'running pid=%s cache=%s\n' "$pid" "$data_dir"
        elif running_pid; then
            printf 'starting pid=%s cache=%s\n' "$pid" "$data_dir"
            exit 1
        else
            printf 'stopped cache=%s\n' "$data_dir"
            exit 1
        fi
        ;;
    benchmark)
        shift
        benchmark_cache "$@"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
