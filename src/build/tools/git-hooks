#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Manage the optional HCTL2 Git hooks for this repository.

Usage:
  git-hooks install
  git-hooks uninstall
  git-hooks status
  git-hooks --help
EOF
}

repo_root=$(git rev-parse --show-toplevel)
hooks_path=src/build/hooks

case "${1:-}" in
    install)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        current=$(git -C "$repo_root" config --get core.hooksPath || true)
        if [ -n "$current" ] && [ "$current" != "$hooks_path" ]; then
            printf 'error: core.hooksPath is already managed elsewhere: %s\n' \
                "$current" >&2
            exit 1
        fi
        git -C "$repo_root" config core.hooksPath "$hooks_path"
        printf 'Installed HCTL2 hooks: %s\n' "$hooks_path"
        ;;
    uninstall)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        current=$(git -C "$repo_root" config --get core.hooksPath || true)
        if [ "$current" = "$hooks_path" ]; then
            git -C "$repo_root" config --unset core.hooksPath
            printf '%s\n' 'Removed HCTL2 hooks.'
        elif [ -n "$current" ]; then
            printf 'error: core.hooksPath is managed elsewhere: %s\n' "$current" >&2
            exit 1
        else
            printf '%s\n' 'HCTL2 hooks are not installed.'
        fi
        ;;
    status)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        current=$(git -C "$repo_root" config --get core.hooksPath || true)
        if [ "$current" = "$hooks_path" ]; then
            printf 'installed path=%s\n' "$current"
        elif [ -n "$current" ]; then
            printf 'not-installed current-path=%s\n' "$current"
            exit 1
        else
            printf '%s\n' 'not-installed'
            exit 1
        fi
        ;;
    --help | -h)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
