load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_VERSION")

oncall("hctl2")

filegroup(
    name = "process_compose_fixtures",
    srcs = glob(["testdata/process-compose/**"]),
)

rust_binary(
    name = "rust_toolchain_probe",
    srcs = ["rust_toolchain_probe.rs"],
    crate_root = "rust_toolchain_probe.rs",
    edition = "2024",
    labels = CI_FAST,
    tests = [":rust_toolchain_test"],
)

rust_test(
    name = "rust_toolchain_test",
    srcs = ["rust_toolchain_test.rs"],
    crate_root = "rust_toolchain_test.rs",
    edition = "2024",
    labels = CI_FAST,
)

sh_test(
    name = "version_contract_test",
    test = "version_contract.sh",
    args = [
        HCTL2_VERSION,
        "$(location root//:Cargo.toml)",
    ],
    labels = CI_FAST,
    resources = ["root//:Cargo.toml"],
)

sh_test(
    name = "python_pin_test",
    test = "check_python_pin.sh",
    env = {
        "HOST_PYTHON3": "$(location root//build/tools:host-python3)",
        "BUCK2_LAUNCHER": "$(location root//:buck2_launcher)",
        "PYTHON_RESEARCH": "$(location repo//:docs_tree)/docs/research/build-tools/python-build-standalone.md",
    },
    labels = CI_FAST,
    resources = [
        "root//build/tools:host-python3",
        "root//:buck2_launcher",
        "repo//:docs_tree",
    ],
    test_rule_timeout_ms = 120000,
)

sh_test(
    name = "process_compose_contract_test",
    test = "check_process_compose_contract.sh",
    env = {
        "PACKAGING_ROOT": "$(location root//packaging/dependencies:service_lifecycle_sources)",
        "PROCESS_COMPOSE_BIN": "$(location root//build/tools:process-compose-bin)",
        "LIFECYCLE_YAML": "$(location :process_compose_fixtures)/testdata/process-compose/lifecycle.yaml",
    },
    labels = CI_FAST,
    resources = [
        "root//build/tools:process-compose-bin",
        ":process_compose_fixtures",
        "root//packaging/dependencies:service_lifecycle_sources",
    ],
    run_test_separately = True,
    test_rule_timeout_ms = 120000,
)
