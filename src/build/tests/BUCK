load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_VERSION")
load("//build/tools:xz.bzl", "XZ_DIRECTORY", "XZ_VERSION")

oncall("hctl2")

# Shared with root//packaging/release:room-cli-clippy-clean-test, which gates the
# report of a release-only target. The gate script is one file either way; only
# the report set it is pointed at differs.
export_file(
    name = "check-clippy-clean.sh",
    src = "check_clippy_clean.sh",
    visibility = ["PUBLIC"],
)

# Clippy's own run writes diagnostics to a report file and still succeeds, so
# this test is what turns a non-empty report into a build failure. The reports
# reach it as the filegroup's directory output, which keeps every entry at
# <crate>/<key>: a flat copy by basename would let one package's empty
# `unit_test` hide another's dirty one, since three packages have that target.
sh_test(
    name = "clippy_clean_test",
    test = "check_clippy_clean.sh",
    env = {"CLIPPY_REPORTS": "$(location root//:clippy)"},
    labels = CI_FAST,
    test_rule_timeout_ms = 120000,
)

# The live gate only sees paths Buck2 chose, so it cannot cover the report shapes
# that would break the gate itself. These fixtures drive it directly.
sh_test(
    name = "clippy_clean_fixtures_test",
    test = "check_clippy_clean_fixtures.sh",
    env = {"GATE_SCRIPT": "$(location :check-clippy-clean.sh)"},
    labels = CI_FAST,
    resources = [":check-clippy-clean.sh"],
    test_rule_timeout_ms = 120000,
)

sh_test(
    name = "xz_test",
    test = "check_xz.sh",
    env = {
        "HCTL2_XZ_ROOT": "$(location root//build/tools:xz)/" + XZ_DIRECTORY,
        "HCTL2_XZ_VERSION": XZ_VERSION,
        "PACKAGING_HELPERS": "$(location root//packaging/dependencies:service_lifecycle_sources)",
    },
    resources = [
        "root//build/tools:xz",
        "root//packaging/dependencies:service_lifecycle_sources",
    ],
    labels = CI_FAST,
    test_rule_timeout_ms = 120000,
)

filegroup(
    name = "process_compose_fixtures",
    srcs = glob(["testdata/process-compose/**"]),
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "rust_toolchain_probe",
    srcs = ["rust_toolchain_probe.rs"],
    crate_root = "rust_toolchain_probe.rs",
    edition = "2024",
    labels = CI_FAST,
    tests = [":rust_toolchain_test"],
)

rust_test(
    name = "rust_toolchain_test",
    srcs = ["rust_toolchain_test.rs"],
    crate_root = "rust_toolchain_test.rs",
    edition = "2024",
    labels = CI_FAST,
)

sh_test(
    name = "version_contract_test",
    test = "version_contract.sh",
    args = [
        HCTL2_VERSION,
        "$(location root//:Cargo.toml)",
    ],
    labels = CI_FAST,
    resources = ["root//:Cargo.toml"],
)

sh_test(
    name = "python_pin_test",
    test = "check_python_pin.sh",
    env = {
        "HOST_PYTHON3": "$(location root//build/tools:host-python3)",
        "BUCK2_LAUNCHER": "$(location root//:buck2_launcher)",
        "PYTHON_RESEARCH": "$(location repo//:docs_tree)/docs/research/build-tools/python-build-standalone.md",
    },
    labels = CI_FAST,
    resources = [
        "root//build/tools:host-python3",
        "root//:buck2_launcher",
        "repo//:docs_tree",
    ],
    test_rule_timeout_ms = 120000,
)

sh_test(
    name = "process_compose_contract_test",
    test = "check_process_compose_contract.sh",
    env = {
        "PACKAGING_ROOT": "$(location root//packaging/dependencies:service_lifecycle_sources)",
        "PROCESS_COMPOSE_BIN": "$(location root//build/tools:process-compose-bin)",
        "LIFECYCLE_YAML": "$(location :process_compose_fixtures)/testdata/process-compose/lifecycle.yaml",
    },
    labels = CI_FAST,
    resources = [
        "root//build/tools:process-compose-bin",
        ":process_compose_fixtures",
        "root//packaging/dependencies:service_lifecycle_sources",
    ],
    run_test_separately = True,
    test_rule_timeout_ms = 120000,
)

sh_test(
    name = "validation_range_test",
    test = "check_validation_range.sh",
    env = {
        "CODE_WORKFLOW": "$(location repo//:code_workflow_yml)",
        "RELEASE_WORKFLOW": "$(location repo//:release_workflow_yml)",
        "JQ_BIN": "$(location root//build/tools:jq-bin)",
        "AFFECTED_TARGETS": "$(location root//:affected_targets)",
    },
    labels = CI_FAST,
    resources = [
        "repo//:code_workflow_yml",
        "repo//:release_workflow_yml",
        "root//build/tools:jq-bin",
        "root//:affected_targets",
    ],
    test_rule_timeout_ms = 120000,
)
