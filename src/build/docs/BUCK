# Doc lint checks. The linted documents live in the `repo` cell (repository
# root): repo//:docs_tree is the root-level documents plus docs/ and .memo/.
# Links from documents into src/ are checked against the working tree by the
# link checker itself (the tests run with the project root as cwd).

load("//build/rules:ci.bzl", "CI_DOCS")

oncall("hctl2")

filegroup(
    name = "configs",
    srcs = glob(["*.txt", "*.allowlist"]),
)

sh_test(
    name = "check_links",
    test = "check_links.pl",
    args = ["$(location repo//:docs_tree)", "$(location :configs)/links.allowlist"],
    labels = CI_DOCS,
    resources = ["repo//:docs_tree", ":configs"],
)

sh_test(
    name = "check_version_stamps",
    test = "check_version_stamps.sh",
    args = ["$(location repo//:docs_tree)", "$(location :configs)/version_stamps.allowlist"],
    labels = CI_DOCS,
    resources = ["repo//:docs_tree", ":configs"],
)

sh_test(
    name = "check_dead_names",
    test = "check_dead_names.sh",
    args = [
        "$(location repo//:docs_tree)",
        "$(location :configs)/dead_names.txt",
        "$(location :configs)/dead_names.allowlist",
    ],
    labels = CI_DOCS,
    resources = ["repo//:docs_tree", ":configs"],
)

sh_test(
    name = "check_memo_review_baseline",
    test = "check_memo_review_baseline.sh",
    args = ["$(location repo//:docs_tree)", "$(location :configs)/memo_review_baseline.allowlist"],
    labels = CI_DOCS,
    resources = ["repo//:docs_tree", ":configs"],
)

sh_test(
    name = "report_prohibition_density",
    test = "report_prohibition_density.sh",
    args = ["$(location repo//:docs_tree)"],
    labels = CI_DOCS,
    resources = ["repo//:docs_tree"],
)

test_suite(
    name = "profile-design",
    labels = CI_DOCS,
    tests = [
        ":check_links",
        ":check_version_stamps",
        ":check_dead_names",
        ":report_prohibition_density",
    ],
)

test_suite(
    name = "profile-spec",
    labels = CI_DOCS,
    tests = [
        ":check_links",
        ":check_version_stamps",
        ":check_dead_names",
        ":report_prohibition_density",
    ],
)

test_suite(
    name = "profile-delivery",
    labels = CI_DOCS,
    tests = [
        ":check_links",
        ":check_version_stamps",
        ":check_dead_names",
        ":report_prohibition_density",
    ],
)

test_suite(
    name = "profile-research",
    labels = CI_DOCS,
    tests = [":check_links"],
)

test_suite(
    name = "profile-memo-review",
    labels = CI_DOCS,
    tests = [":check_memo_review_baseline"],
)

test_suite(
    name = "profile-all",
    labels = CI_DOCS,
    tests = [
        ":check_links",
        ":check_version_stamps",
        ":check_dead_names",
        ":check_memo_review_baseline",
        ":report_prohibition_density",
    ],
)
