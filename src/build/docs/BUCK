sh_test(
    name = "check_docs_toolchain_fixtures",
    test = "check_docs_toolchain_fixtures.sh",
    env = {
        "DOC_STYLE_LINT": "$(location :fixture_inputs)/doc_style_lint.pl",
        "SPEC_VOCABULARY": "$(location :fixture_inputs)/testdata/spec-vocabulary.md",
        "IMPLEMENTATION_NAMES": "$(location :fixture_inputs)/implementation_names.txt",
        "DOCS_TREE": "$(location repo//:docs_tree)",
        "PR_CONTRACT_YML": "$(location repo//:pr_contract_yml)",
        "ALLOWLIST_DIR": "$(location :fixture_inputs)",
    },
    labels = CI_DOCS,
    resources = [
        ":fixture_inputs",
        "repo//:docs_tree",
        "repo//:pr_contract_yml",
    ],
)

