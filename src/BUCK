load("//build/rules:ci.bzl", "CI_FULL")

oncall("hctl2")

export_file(
    name = "affected_targets",
    src = "build/ci/affected-targets",
    visibility = ["PUBLIC"],
)

export_file(
    name = "clippy_coverage",
    src = "build/ci/clippy-coverage",
    visibility = ["PUBLIC"],
)

export_file(
    name = "Cargo.toml",
    src = "Cargo.toml",
    visibility = ["PUBLIC"],
)

export_file(
    name = "buck2_launcher",
    src = "buck2",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "clippy",
    srcs = {
        "chat": "root//crates/chat:clippy",
        "cli": "root//apps/cli:clippy",
        "control": "root//apps/control:clippy",
        "facts": "root//crates/facts:clippy",
        "foundation": "root//crates/foundation:clippy",
        "proto": "root//crates/proto:clippy",
        "project": "root//crates/project:clippy",
        "repo": "root//crates/repo:clippy",
        "store": "root//crates/store:clippy",
        "task": "root//crates/task:clippy",
        "tool": "root//apps/tool:clippy",
    },
    labels = CI_FULL,
    visibility = ["PUBLIC"],
)

# First-party Markdown under src/ (skills, packaging and workspace READMEs),
# scanned by the dead-name check alongside repo//:docs_tree. Each nested BUCK
# package exports its own glob. Preserve source-relative paths for exemptions;
# CI compares the transitive inputs with Git to reject a missing package.
filegroup(
    name = "src_docs_tree",
    srcs = {
        path: path
        for path in glob(
            ["README.md", "**/*.md"],
            exclude = ["third-party/**", "buck-out/**", "target/**"],
        )
    } | {
        "agency": "root//agency:docs",
        "apps/control": "root//apps/control:docs",
        "build/docs": "root//build/docs:docs",
        "crates/chat": "root//crates/chat:docs",
        "crates/project": "root//crates/project:docs",
        "crates/proto": "root//crates/proto:docs",
        "crates/repo": "root//crates/repo:docs",
        "crates/store": "root//crates/store:docs",
        "crates/task": "root//crates/task:docs",
        "packaging/dependencies": "root//packaging/dependencies:docs",
        "packaging/release": "root//packaging/release:docs",
    },
    visibility = ["PUBLIC"],
)
