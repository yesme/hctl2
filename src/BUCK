load("//build/rules:ci.bzl", "CI_FULL")

oncall("hctl2")

export_file(
    name = "Cargo.toml",
    src = "Cargo.toml",
    visibility = ["PUBLIC"],
)

export_file(
    name = "buck2_launcher",
    src = "buck2",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "clippy",
    srcs = {
        "hctl2-facts": "root//crates/hctl2-facts:clippy",
        "hctl2-foundation": "root//crates/hctl2-foundation:clippy",
        "hctl2-tool": "root//apps/hctl2-tool:clippy",
    },
    labels = CI_FULL,
    visibility = ["PUBLIC"],
)

# First-party Markdown under src/ (skills, packaging and workspace READMEs),
# scanned by the dead-name check alongside repo//:docs_tree. Vendored trees and
# build outputs are not first-party text.
filegroup(
    name = "src_docs_tree",
    srcs = glob(
        ["README.md", "**/*.md"],
        exclude = ["third-party/**", "buck-out/**", "target/**"],
    ),
    visibility = ["PUBLIC"],
)
