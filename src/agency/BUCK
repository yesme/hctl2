]

CLI_DEPS = [
    ":service",
    "root//crates/agency-proto:agency_proto",
    "root//third-party/rust:clap",
    "root//third-party/rust:serde_json",
    "root//third-party/rust:tokio",
]

rust_library(
    name = "service",
    crate = "agency",
    srcs = glob(["src/**/*.rs", "src/harness/turn.js"], exclude = ["src/main.rs"]),
    crate_root = "src/lib.rs",
    deps = DEPS,
    edition = HCTL2_RUST_EDITION,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    tests = [":unit_test", ":port_test", ":control_port_test", ":runtime_test"],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "unit_test",
    srcs = glob(["src/**/*.rs", "src/harness/turn.js"], exclude = ["src/main.rs"]),
