load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

STORE_DEPS = [
    "root//crates/foundation:foundation",
    "root//third-party/rust:rusqlite",
    "root//third-party/rust:rusqlite_migration",
    "root//third-party/rust:serde",
    "root//third-party/rust:serde_json",
]

rust_library(
    name = "store",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = STORE_DEPS,
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    tests = [":unit_test", ":command_test", ":materials_test", ":recovery_test", ":model_test"],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "unit_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = STORE_DEPS,
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

[
    rust_test(
        name = suite + "_test",
        srcs = ["tests/" + suite + ".rs", "tests/common/mod.rs"],
        crate_root = "tests/" + suite + ".rs",
        deps = [":store"] + STORE_DEPS,
        edition = HCTL2_RUST_EDITION,
        env = hctl2_cargo_env(),
        labels = CI_FAST,
        rustc_flags = HCTL2_RUSTC_FLAGS,
        visibility = ["PUBLIC"],
    )
    for suite in ["command", "materials", "recovery", "model"]
]

filegroup(
    name = "clippy",
    srcs = {
        "library": ":store[clippy.txt]",
        "unit": ":unit_test[clippy.txt]",
        "command": ":command_test[clippy.txt]",
        "materials": ":materials_test[clippy.txt]",
        "recovery": ":recovery_test[clippy.txt]",
        "model": ":model_test[clippy.txt]",
    },
    labels = CI_FAST,
    visibility = ["PUBLIC"],
)
