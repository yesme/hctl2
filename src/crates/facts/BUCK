load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

_TEST_ENV = hctl2_cargo_env() | {
    # Built fixture scripts the tests execute as processes; see src/BUCK.
    "HCTL2_FIXTURES": "$(location root//:script_fixtures)/fixtures/scripts",
}

_TEST_RESOURCES = ["root//:script_fixtures"]

rust_library(
    name = "facts",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    deps = [
        "root//crates/foundation:foundation",
        "root//third-party/rust:notify",
        "root//third-party/rust:serde",
        "root//third-party/rust:serde_json",
        "root//third-party/rust:sha2",
    ],
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    tests = [":unit_test"],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "unit_test",
    srcs = ["src/lib.rs"],
    crate_root = "src/lib.rs",
    deps = [
        "root//crates/foundation:foundation",
        "root//third-party/rust:notify",
        "root//third-party/rust:serde",
        "root//third-party/rust:serde_json",
        "root//third-party/rust:sha2",
    ],
    edition = HCTL2_RUST_EDITION,
    env = _TEST_ENV,
    labels = CI_FAST,
    resources = _TEST_RESOURCES,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "clippy",
    srcs = {
        "library": ":facts[clippy.txt]",
        "unit": ":unit_test[clippy.txt]",
    },
    labels = CI_FAST,
    visibility = ["PUBLIC"],
)
