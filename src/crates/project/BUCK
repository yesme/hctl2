load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")

oncall("hctl2")

# Export this package's Markdown; the root glob stops at BUCK boundaries.
filegroup(
    name = "docs",
    srcs = glob(["**/*.md"]),
    visibility = ["PUBLIC"],
)

DEPS = [
    "root//crates/chat:chat",
    "root//crates/foundation:foundation",
    "root//crates/repo:repo",
    "root//crates/store:store",
    "root//crates/task:task",
    "root//third-party/rust:serde",
    "root//third-party/rust:serde_json",
]

rust_library(
    name = "project",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    deps = DEPS,
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    tests = [":domain_test"],
    visibility = ["PUBLIC"],
)

rust_test(
    name = "domain_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/domain.rs",
    deps = [":project"] + DEPS,
    edition = HCTL2_RUST_EDITION,
    env = hctl2_cargo_env(),
    labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS,
    visibility = ["PUBLIC"],
)

filegroup(
    name = "clippy",
    srcs = {"library": ":project[clippy.txt]", "domain": ":domain_test[clippy.txt]"},
    labels = CI_FAST,
    visibility = ["PUBLIC"],
)
