load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")
oncall("hctl2")
filegroup(name = "docs", srcs = glob(["**/*.md"]), visibility = ["PUBLIC"])
DEPS = ["root//crates/agency-proto:agency_proto", "root//crates/foundation:foundation", "root//crates/store:store", "root//third-party/rust:serde", "root//third-party/rust:serde_json"]
rust_library(name = "participant", srcs = glob(["src/**/*.rs"]), crate_root = "src/lib.rs", deps = DEPS,
    edition = HCTL2_RUST_EDITION, rustc_flags = HCTL2_RUSTC_FLAGS, env = hctl2_cargo_env(), labels = CI_FAST, tests = [":profiles_test", ":dispatch_test"], visibility = ["PUBLIC"])
rust_test(name = "profiles_test", srcs = ["tests/profiles.rs"], crate_root = "tests/profiles.rs", deps = [":participant"] + DEPS,
    edition = HCTL2_RUST_EDITION, rustc_flags = HCTL2_RUSTC_FLAGS, env = hctl2_cargo_env(), labels = CI_FAST, visibility = ["PUBLIC"])
rust_test(name = "dispatch_test", srcs = ["tests/dispatch.rs"], crate_root = "tests/dispatch.rs", deps = [":participant"] + DEPS,
    edition = HCTL2_RUST_EDITION, rustc_flags = HCTL2_RUSTC_FLAGS, env = hctl2_cargo_env(), labels = CI_FAST, visibility = ["PUBLIC"])
filegroup(name = "clippy", srcs = {"library": ":participant[clippy.txt]", "profiles": ":profiles_test[clippy.txt]", "dispatch": ":dispatch_test[clippy.txt]"}, labels = CI_FAST, visibility = ["PUBLIC"])
