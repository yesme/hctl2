load("//build/rules:ci.bzl", "CI_FAST")
load("//build/rules:rust.bzl", "HCTL2_RUST_EDITION", "HCTL2_RUSTC_FLAGS", "hctl2_cargo_env")
oncall("hctl2")
filegroup(name = "docs", srcs = glob(["**/*.md"]), visibility = ["PUBLIC"])
DEPS = [
    "root//crates/agency-proto:agency_proto",
    "root//crates/chat:chat",
    "root//crates/context:context",
    "root//crates/gate-tally:gate_tally",
    "root//crates/participant:participant",
    "root//crates/repo:repo",
    "root//crates/task:task",
    "root//crates/foundation:foundation",
    "root//crates/store:store",
    "root//third-party/rust:serde",
    "root//third-party/rust:serde_json",
]
rust_library(
    name = "run", srcs = glob(["src/**/*.rs"]), crate_root = "src/lib.rs", deps = DEPS,
    edition = HCTL2_RUST_EDITION, env = hctl2_cargo_env(), labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS, tests = [":domain_test"], visibility = ["PUBLIC"],
)
rust_test(
    name = "domain_test", srcs = glob(["tests/**/*.rs"]), crate_root = "tests/domain.rs", deps = [":run"] + DEPS,
    edition = HCTL2_RUST_EDITION, env = hctl2_cargo_env() | {"HCTL2_TEST_DAGU_CACHE": "$(location root//packaging/dependencies:dagu)", "CARGO_BIN_EXE_hctl2": "$(location root//apps/cli:hctl2)", "CARGO_BIN_EXE_hctl2-control": "$(location root//apps/control:hctl2-control)"}, labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS, visibility = ["PUBLIC"],
)
rust_test(
    name = "lifecycle_test", srcs = glob(["tests/**/*.rs"]), crate_root = "tests/lifecycle.rs", deps = [":run"] + DEPS,
    edition = HCTL2_RUST_EDITION, env = hctl2_cargo_env() | {"CARGO_BIN_EXE_hctl2": "$(location root//apps/cli:hctl2)", "CARGO_BIN_EXE_hctl2-control": "$(location root//apps/control:hctl2-control)"}, labels = CI_FAST,
    rustc_flags = HCTL2_RUSTC_FLAGS, visibility = ["PUBLIC"],
)
filegroup(name = "clippy", srcs = {"library": ":run[clippy.txt]", "domain": ":domain_test[clippy.txt]", "lifecycle": ":lifecycle_test[clippy.txt]"}, labels = CI_FAST, visibility = ["PUBLIC"])
